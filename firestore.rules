rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
    }

    function hasRole(role) {
      return signedIn() && role in userDoc().roles;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    // ============================================================================
    // H3.3 SCHOOL ADMINISTRATION FUNCTIONS
    // ============================================================================
    function isSchoolAdmin(schoolId) {
      return signedIn() && exists(/databases/$(database)/documents/schools/$(schoolId)/admins/$(request.auth.uid));
    }

    function canAccessSchool(schoolId) {
      return isAdmin() || isSchoolAdmin(schoolId);
    }

    function memberPath(familyId) {
      return /databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid);
    }

    function isActiveFamilyMember(familyId) {
      return signedIn() && exists(memberPath(familyId))
        && get(memberPath(familyId)).data.status == 'active';
    }

    function isFamilyAdult(familyId) {
      return isActiveFamilyMember(familyId)
        && get(memberPath(familyId)).data.role in ['parent', 'guardian'];
    }

    function isAssignedFacilitator(familyId, childId) {
      return signedIn() && hasRole('facilitator')
        && 'facilitatorUids' in get(/databases/$(database)/documents/families/$(familyId)/children/$(childId)).data
        && get(/databases/$(database)/documents/families/$(familyId)/children/$(childId)).data.facilitatorUids.hasAny([request.auth.uid]);
    }

    function canAccessChild(familyId, childId) {
      return isFamilyAdult(familyId) || isAssignedFacilitator(familyId, childId) || isAdmin();
    }

    function immutableOwnership(existing, proposed) {
      return proposed.familyId == existing.familyId
        && proposed.id == existing.id
        && proposed.createdBy == existing.createdBy;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.roles is list
        && request.resource.data.status == 'pending';
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.roles == resource.data.roles
        && request.resource.data.status == resource.data.status;
      allow delete: if isAdmin();
    }

    match /families/{familyId} {
      allow read: if isActiveFamilyMember(familyId) || isAdmin();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if (isActiveFamilyMember(familyId) || isAdmin())
        && request.resource.data.familyId == resource.data.familyId
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isAdmin();

      match /members/{uid} {
        allow read: if isActiveFamilyMember(familyId) || isAdmin();
        allow create, update, delete: if isAdmin();
      }

      match /children/{childId} {
        allow read: if canAccessChild(familyId, childId);
        allow create: if isFamilyAdult(familyId)
          && request.resource.data.familyId == familyId
          && request.resource.data.id == childId
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if canAccessChild(familyId, childId)
          && immutableOwnership(resource.data, request.resource.data);
        allow delete: if isAdmin() || isFamilyAdult(familyId);

        match /journeyProgress/{itemKey} {
          allow read: if canAccessChild(familyId, childId);
          allow create, update: if (isFamilyAdult(familyId) || isAssignedFacilitator(familyId, childId) || isAdmin())
            && request.resource.data.familyId == familyId
            && request.resource.data.childId == childId
            && request.resource.data.score == null
            && request.resource.data.maxScore == null;
          allow delete: if isAdmin();
        }

        match /assessmentAttempts/{attemptId} {
          allow read: if canAccessChild(familyId, childId);
          allow write: if false;
        }

        match /scenarioSessions/{scenarioKey} {
          allow read: if canAccessChild(familyId, childId);
          allow write: if false;

          match /decisions/{decisionId} {
            allow read: if canAccessChild(familyId, childId);
            allow write: if false;
          }
        }

        match /competencies/{competencyId} {
          allow read: if canAccessChild(familyId, childId);
          allow write: if false;
        }

        match /achievements/{achievementId} {
          allow read: if canAccessChild(familyId, childId);
          allow write: if false;
        }

        match /parentInsights/{insightId} {
          allow read: if isFamilyAdult(familyId) || isAdmin();
          allow write: if false;
        }
      }
    }

    match /childCredentials/{tatiId} {
      allow read, write: if false;
    }

    match /childSessions/{sessionId} {
      allow read, write: if false;
    }

    match /feedback/{feedbackId} {
      allow read: if signedIn() && (resource.data.submittedByUid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.submittedByUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /analyticsEvents/{eventId} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'eventName', 'actorUid', 'childId', 'familyId', 'entityId', 'eventKey', 'occurredAt'
        ]);
      allow update, delete: if false;
    }

    match /childAuthIdentities/{childProfileId} {
      allow read, write: if false;
    }

    // ============================================================================
    // ACADEMY COLLECTIONS (H3.2.2 — FACILITATOR DASHBOARD & COHORT WORKFLOW)
    // ============================================================================
    // These collections support the Academy facilitator operating environment.
    // Facilitators access ONLY their assigned learners, with read-only access to
    // learning progress. Facilitators cannot modify child learning records.
    // All parent-private data (parentInsights) remains inaccessible.
    // ============================================================================

    match /facilitatorAssignments/{assignmentId} {
      // Assignment documents enable efficient lookup of assigned children
      // Schema: { facilitatorUid, familyId, childId, createdAt, assignedBy }
      // Authorization: Facilitator can read only their own assignments
      allow read: if signedIn() && hasRole('facilitator') && resource.data.facilitatorUid == request.auth.uid;
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================================================
    // ACADEMY SESSIONS (H3.2.8 — FACILITATOR SESSION PERSISTENCE)
    // ============================================================================
    // Facilitator sessions record the operational context of facilitated activities.
    // Sessions are owned by facilitators, immutable after creation.
    // Sessions do NOT modify learner progress.
    // ============================================================================

    match /academySessions/{sessionId} {
      // Create: Authenticated facilitator only
      allow create: if signedIn() && hasRole('facilitator')
        && request.resource.data.facilitatorUid == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.startedAt != null
        && request.resource.data.endedAt == null;

      // Read: Owner or admin only
      allow read: if request.auth.uid == resource.data.facilitatorUid || isAdmin();

      // Update: Owner only, with immutable ownership and identity fields
      allow update: if request.auth.uid == resource.data.facilitatorUid
        && request.resource.data.facilitatorUid == resource.data.facilitatorUid
        && request.resource.data.activityId == resource.data.activityId
        && request.resource.data.learnerIds == resource.data.learnerIds
        && request.resource.data.startedAt == resource.data.startedAt
        && request.resource.data.createdAt == resource.data.createdAt;

      // Delete: Prevent deletion of historical session records
      allow delete: if false;
    }

    // ============================================================================
    // ACADEMY COHORTS (H3.2.9 — FACILITATOR COHORT MANAGEMENT)
    // ============================================================================
    // Facilitator cohorts are named groups of assigned learners.
    // Cohorts are owned by facilitators and organized on top of facilitatorAssignments.
    // Cohorts do NOT modify learner progress, assignments, or protected data.
    // Ownership (facilitatorUid) is immutable after creation.
    // ============================================================================

    match /academyCohorts/{cohortId} {
      // Create: Authenticated facilitators only
      // Validates: cohort owner is self, valid name, active status
      allow create: if signedIn() && hasRole('facilitator')
        && request.resource.data.facilitatorUid == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.name != null
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100;

      // Read: Owner or admin only
      // Facilitators can only see their own cohorts
      allow read: if request.auth.uid == resource.data.facilitatorUid || isAdmin();

      // Update: Owner only, with immutability checks
      // Prevents: ownership change, timestamp modification
      // Allows: name, description, learnerIds, status changes
      allow update: if request.auth.uid == resource.data.facilitatorUid
        && request.resource.data.facilitatorUid == resource.data.facilitatorUid
        && request.resource.data.createdAt == resource.data.createdAt;

      // Delete: Prevent deletion (archive instead)
      // Cohort history must be preserved
      allow delete: if false;
    }

    // ============================================================================
    // SCHOOLS (H3.3 — SCHOOL ADMINISTRATION)
    // ============================================================================
    // Schools are organizational entities that group facilitators and cohorts.
    // School admins manage facilitators, cohorts, and learners within their school.
    // School isolation is enforced via isSchoolAdmin() and canAccessSchool() functions.
    // ============================================================================

    match /schools/{schoolId} {
      // Read: School admin or platform admin only
      allow read: if canAccessSchool(schoolId);

      // Create: Platform admin only
      allow create: if isAdmin()
        && request.resource.data.status == 'active'
        && request.resource.data.name != null
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200;

      // Update: Platform admin only, prevent ownership/identity changes
      allow update: if isAdmin()
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt;

      // Delete: Prevent deletion (archive instead)
      // School history must be preserved
      allow delete: if false;

      match /admins/{adminUid} {
        // Read: School admin or platform admin only
        allow read: if canAccessSchool(schoolId);

        // Create: Platform admin only
        allow create: if isAdmin();

        // Update: Platform admin only
        allow update: if isAdmin();

        // Delete: Platform admin only
        allow delete: if isAdmin();
      }
    }
  }
}
