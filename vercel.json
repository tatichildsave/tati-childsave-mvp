{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist/client",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "dist/server/**"
    }
  },
  "rewrites": [
    {
      "source": "^/(?!(?:assets|favicon|robots)\\..*|.*\\.(?:js|css|jpeg|jpg|png|svg|ico|txt|woff|woff2|ttf|eot|map|webp|gif|webmanifest)$)(.*)",
      "destination": "/api"
    }
  ]
}
