# Firebase web configuration (safe for client-side use; do not add Admin credentials here)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional. Leave empty until Firebase Analytics is explicitly needed.
VITE_FIREBASE_MEASUREMENT_ID=

# Existing Supabase variables remain active during the gradual migration.
# Configure these directly with a Supabase project you control.
# VITE_ values are public client configuration, never service-role credentials.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server only: configure in Vercel, never in VITE_ variables.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=

# No scheduled jobs are configured; no cron secret is required.
